{
  "name": "attendchain",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized student attendance management platform on Ethereum Sepolia and Hardhat",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests blockchain",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"blockchain/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"blockchain/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "contracts:compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "test:contracts:coverage": "hardhat coverage",
    "contracts:deploy:local": "hardhat run blockchain/scripts/deploy-and-seed.ts --network localhost",
    "contracts:deploy:sepolia": "hardhat run blockchain/scripts/verify-sepolia.ts --network sepolia"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "ethers": "6.17.0",
    "jose": "6.2.12",
    "lucide-react": "1.55.0",
    "next": "15.5.27",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "hardhat": "2.29.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
